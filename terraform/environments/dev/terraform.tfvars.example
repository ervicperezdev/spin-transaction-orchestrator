aws_region                  = "us-east-1"
vpc_cidr                    = "10.42.0.0/16"
availability_zones          = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs        = ["10.42.0.0/20", "10.42.16.0/20"]
public_subnet_cidrs         = ["10.42.48.0/24", "10.42.49.0/24"]
database_subnet_cidrs       = ["10.42.32.0/24", "10.42.33.0/24"]
route53_zone_name           = "example.com"
application_hostname        = "transaction-api.example.com"
allowed_control_plane_cidrs = ["10.0.0.0/8"] # Replace with approved admin-network ranges.
# Minimum-cost dev profile. Keep production values in its separate environment.
enable_waf                          = false
node_instance_types                  = ["t3.medium"]
node_min_size                        = 1
node_desired_size                    = 1
node_max_size                        = 2
cluster_log_types                    = ["api", "audit"]
rds_instance_class                   = "db.t4g.micro"
rds_backup_retention_period          = 1
rds_deletion_protection              = false
rds_multi_az                         = false
rds_enabled_cloudwatch_logs_exports  = []
# Teardown safety defaults: preserve data and refuse deletion of a non-empty
# repository. Use the protected teardown workflow and explicit approval before
# changing either value for an ephemeral cleanup.
rds_skip_final_snapshot       = false
# rds_final_snapshot_identifier = "spin-transaction-orchestrator-dev-final-20260910"
ecr_force_delete              = false
# Do not put secret values here. Exact Secrets Manager ARNs may be supplied after review.
workload_secret_arns = []
# Terraform does not create secret values. Supply the exact ARN after its value
# is created out of band by an authorized secret owner.
# workload_secret_arns = ["arn:aws:secretsmanager:us-east-1:123456789012:secret:spin/transaction-api/dev-XXXXXX"]
# EKS OIDC provider creation is a one-time, account-reviewed bootstrap action.
eks_oidc_provider_arn    = "arn:aws:iam::123456789012:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/REPLACE_ME"
eks_oidc_issuer_hostpath = "oidc.eks.us-east-1.amazonaws.com/id/REPLACE_ME"
terraform_state_bucket_name = "spin-transaction-state"
terraform_state_key         = "spin-transaction-orchestrator/dev/terraform.tfstate"
# Optional organization-specific exception policy. The module already creates
# and attaches its versioned Terraform provisioner policy; do not attach
# AdministratorAccess.
# terraform_apply_managed_policy_arns = [
#   "arn:aws:iam::123456789012:policy/spin-terraform-development-provisioner"
# ]
